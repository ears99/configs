general {
	colors = true
	interval = 5
	color_good = "#00ff00"
	color_bad = "#ff0000"
	color_degraded = "#ffff00"

}

order += "wireless _first_"
order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "tztime local"


wireless _first_ {
	format_up = "WiFi: %essid %quality"
	format_down = "WiFi: down"
}

ethernet _first_ {
	format_up = "Ethernet: %ip"
	format_down = "Ethernet: down"
}

cpu_usage {
	format = "CPU: %usage"
}

memory {
	format = "RAM: %used / %total"
}

disk "/" {
	format = "Disk: %avail"
}

tztime local {
	format = "%a, %b %d %Y | %I:%M%p"
}
